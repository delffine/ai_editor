# Переменные ИИ-редактора. Сами значения сюда НЕ записывать — это шаблон в репозитории.
# На VPS они лежат в двух файлах с правами 600:
#   ~/.config/ai-editor.env          — его подгружают run.sh и rewrite_worker.sh (видит Claude Code)
#   ~/.config/ai-editor-publish.env  — читает только finish.py (Claude этот файл не видит)

# --- ~/.config/ai-editor.env ---
# Токен подписки Claude для headless-режима: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Адрес JSON-ленты сборщика на RU VPS (collector/collector.py --out …)
AI_EDITOR_FEED_URL=

# Необязательные настройки finish.py (значения по умолчанию)
# AI_EDITOR_DECAY_MIN=60        # затухание: итоговый = базовый / (1 + мин в выдаче / 60)
# AI_EDITOR_URGENT_RUNS=2       # «Срочно» живёт не больше 2 прогонов…
# AI_EDITOR_URGENT_MAX_MIN=70   # …и не больше 70 минут
# AI_EDITOR_QUEUE_MAX=10
# AI_EDITOR_RESERVE_MAX=8
# AI_EDITOR_KTV_FACTOR=0.4      # штраф источнику-конкуренту
# AI_EDITOR_NEXT_AFTER=6        # «следующее обновление» = слот cron + 6 мин
# AI_EDITOR_REWRITE_MODEL=      # модель для рерайта (пусто — по умолчанию)
# AI_EDITOR_REWRITE_TIMEOUT=240

# --- ~/.config/ai-editor-publish.env ---
AI_EDITOR_PUBLISH_URL=http://localhost:8808/ai-editor/publish.php
AI_EDITOR_PUBLISH_TOKEN=

# --- токены, вписываемые в код при установке (в репозитории — CHANGE_ME) ---
# server/publish.php            $SECRET      = AI_EDITOR_PUBLISH_TOKEN
# server/rewrite/rewrite.php    $SECRET      = токен рерайта
# server/rewrite/news_ai_rewrite.php AI_RW_TOKEN = тот же токен рерайта, AI_RW_URL — адрес VPS
